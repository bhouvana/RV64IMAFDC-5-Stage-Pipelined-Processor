# Generated by sim/tools/asm.py from sim/programs/*.s -- not source, regenerate via `make test` or sim/run_tests.sh
sim/programs/*.mem
sim/benchmarks/*.mem

# Icarus Verilog compile output / VCD waveforms
*.vvp
*.vcd

# Stray artifacts from earlier manual iverilog invocations, kept out of git going forward
/design/design
/simulation/simulation

# Generated by sim/tb/gen_trace.v / sim/tools/gen_trace.py / build_viewer.py --
# regenerate from sim/tools/viewer_template.html (the actual source)
/trace.csv
pipeline-viewer*.html
sim/tools/*.json

# Generated by sim/tools/coverage_report.py (design/riscvpipeline.v's
# dump_coverage task) and sim/tools/run_random_tests.py's --keep-failures
/coverage.txt
/random_fail_*/

__pycache__/
*.pyc

# Local session-continuity doc for future Claude sessions picking this up
# cold -- kept on disk, deliberately not published to the remote.
/handoff.md

# Generated by sby (SymbiYosys) -- run output per sim/formal/*.sby task
# (logs, solver traces, PASS/FAIL marker), not source. Regenerate via
# `sby -f sim/formal/<name>.sby`.
/sim/formal/register_formal/
/sim/formal/forward_formal/
/sim/formal/hazard_formal/
/sim/formal/hazard_noforward_formal/
/sim/formal/csr_formal/
/sim/formal/pipeline_formal/
/sim/formal/rob_formal/

# Generated by sim/tools/build_sbi_firmware.py / build_linux_boot.py --
# ELF/`.mem`/DTB build output, not source. Regenerate from sim/firmware/'s
# own real source (boot.S/trap_entry.S/sbi.c/link_sbi.ld/etc).
/sim/firmware/build/
/sim/firmware/build_linux/

# Downloaded third-party kernel-boot assets (real Linux Image/initramfs +
# two abandoned dead-end downloads kept only as this phase's own research
# trail) -- large binaries, not this project's own source. See
# docs/adr/0036 for provenance/how to re-obtain.
/sim/firmware/kernel_boot/

# Verilator-generated C++ model + compiled harness binary + run artifacts,
# not source. Regenerate via sim/tools/build_kernel_boot.py.
/sim/verilator/obj_dir/
/sim/verilator/obj_dir_boot/
/sim/verilator/obj_dir_sbi/
/sim/verilator/vboot.exe
/sim/verilator/boot_console.log

# Local Claude Code project settings, not project source.
/.claude/

# Vivado FPGA workflow (fpga/vivado/, docs/superpowers/plans/
# 2026-08-11-vivado-fpga-synthesis-workflow.md) -- project builds/runs/caches
# are regenerable from fpga/vivado/create_project.tcl + run_all.tcl, not
# source. Only fpga/vivado/reports/ (hand-picked .rpt copies) is checked in.
/fpga/vivado/build/
*.jou
*.log
*.str
.Xil/
*.wdb
webtalk*.jou
webtalk*.log
*.lic
